# The app does not load .env. Export settings explicitly; never commit secrets.
# API_PORT changes the UI's local API port. See docs/judging.md for CCA-003.
# Other resource/model variables below remain planned; manifest bounds are fixed.
# Never commit actual API keys or real contestant files.
APP_PORT=8501
API_PORT=8000

# Python-only MVP. Judge must stay DISABLED if hardened sandbox checks fail.
JUDGE_EXECUTION_ENABLED=false
# Both flags are required; each offline worker must still pass real qualification.
JUDGE_REVIEWED_PROFILE=false
JUDGE_SANDBOX_BACKEND=nsjail
JUDGE_MAX_SUBMISSION_FILES=30
JUDGE_MAX_ARCHIVE_BYTES=10485760
JUDGE_MAX_EXTRACTED_BYTES=52428800
JUDGE_MAX_TEST_SECONDS=3
JUDGE_MAX_TEST_MEMORY_MB=256

# Model providers become functional in Release 0.2, not Release 0.1.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_1=
OLLAMA_MODEL_2=
OLLAMA_MODEL_3=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL_1=
OPENROUTER_MODEL_2=
OPENROUTER_MODEL_3=
AI_MAX_CALLS_PER_GENERATION=6
AI_REQUEST_TIMEOUT_SECONDS=60
